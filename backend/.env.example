# 이 파일을 .env로 복사해 값을 채웁니다. .env는 git에 올라가지 않습니다.

# 서버 포트 (프론트엔드 config.js의 기본값과 같게 둡니다)
PORT=4000

# 이 서버를 호출할 수 있는 프론트엔드 주소 (쉼표로 구분)
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:4000

# 외부 API에 보낼 User-Agent (Nominatim 이용 정책상 연락처를 넣어야 합니다)
USER_AGENT=cupcake-cbd-explorer/0.1 (+https://cupcakeprofile.vercel.app)

# SGIS OpenAPI 키 (선택). 비워 두면 브라우저 설정 창에 입력한 키를 사용합니다.
SGIS_KEY=
SGIS_SECRET=

# 데이터베이스 (아직 연결하지 않음). 드라이버를 붙이면 src/db/index.js에서 사용합니다.
# 예: postgres://user:password@localhost:5432/cupcake
DATABASE_URL=

# 관리자 비밀번호 해시 — 직접 쓰지 말고 `npm run set-password`로 만듭니다 (원문은 저장되지 않음)
ADMIN_PASSWORD_HASH=

# 프로젝트 저장 폴더 (기본: backend/data)
DATA_DIR=
